FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

rho
{
    type        uniform;
    value       2650;//7854;
}

nu
{
    type        uniform;
    value       0.15;//0.3;
}

E
{
    type        uniform;
    value       8e10;//2e11;
}

planeStress     yes;

fluidPressure [1 -1 -2 0 0 0 0] 2e6;

